# Copia este archivo a ".env" y pega la URL de la API de tu compañero (termina en /api).
# API desplegada en AWS (CloudFront), URL fija.
EXPO_PUBLIC_API_URL=https://d1zwtjt6sp3l7r.cloudfront.net/api

# Backend propio en Supabase (Project Settings → API). Solo la publishable key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
