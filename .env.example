# Copia este archivo a ".env" y pega la URL de la API de tu compañero (termina en /api).
# Si usa un túnel de trycloudflare.com, la URL cambia cada vez que lo reinicia:
# actualízala aquí y reinicia con: npx expo start --clear
EXPO_PUBLIC_API_URL=

# Backend propio en Supabase (Project Settings → API). Solo la publishable key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
